  <diagram name="vxlan" id="9buNEOIDslgDsuhzFnsn">
    <mxGraphModel dx="2263" dy="821" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="BKSNG3rdrQjJdVUIzN5r-87" parent="1" style="whiteSpace=wrap;html=1;align=left;fillColor=#647687;fontColor=#ffffff;strokeColor=#314354;" value="&lt;div&gt;# ====== 5. L2VNI：VLAN 10（VNI 10010） ======&lt;/div&gt;&lt;div&gt;ip link add vni10010 type vxlan local 10.1.0.1 dstport 4789 id 10010 nolearning&lt;/div&gt;&lt;div&gt;ip link set vni10010 master br1 addrgenmode none&lt;/div&gt;&lt;div&gt;ip link set vni10010 type bridge_slave neigh_suppress on learning off&lt;/div&gt;&lt;div&gt;ip link set vni10010 up&lt;/div&gt;&lt;div&gt;bridge vlan add dev vni10010 vid 10&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# VLAN 10 SVI（网关）&lt;/div&gt;&lt;div&gt;ip link add br1.10 link br1 type vlan id 10&lt;/div&gt;&lt;div&gt;ip link set br1.10 master Vrf1&lt;/div&gt;&lt;div&gt;ip addr add 10.0.10.1/24 dev br1.10&lt;/div&gt;&lt;div&gt;ip link set br1.10 up&lt;br&gt;&lt;br&gt;&lt;div&gt;# ====== 6. L2VNI：VLAN 20（VNI 10020） ======&lt;/div&gt;&lt;div&gt;ip link add vni10020 type vxlan local 10.1.0.1 dstport 4789 id 10020 nolearning&lt;/div&gt;&lt;div&gt;ip link set vni10020 master br1 addrgenmode none&lt;/div&gt;&lt;div&gt;ip link set vni10020 type bridge_slave neigh_suppress on learning off&lt;/div&gt;&lt;div&gt;ip link set vni10020 up&lt;/div&gt;&lt;div&gt;bridge vlan add dev vni10020 vid 20&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# VLAN 20 SVI（网关）&lt;/div&gt;&lt;div&gt;ip link add br1.20 link br1 type vlan id 20&lt;/div&gt;&lt;div&gt;ip link set br1.20 master Vrf1&lt;/div&gt;&lt;div&gt;ip addr add 10.0.20.1/24 dev br1.20&lt;/div&gt;&lt;div&gt;ip link set br1.20 up&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="380" width="430" x="190" y="360" as="geometry" />
        </mxCell>
        <mxCell id="BKSNG3rdrQjJdVUIzN5r-85" parent="1" style="whiteSpace=wrap;html=1;align=left;strokeColor=#B20000;fillColor=#e51400;fontColor=#ffffff;" value="&lt;div&gt;# ====== 4. L3VNI（VNI 5000） ======&lt;/div&gt;&lt;div&gt;ip link add vni4000 type vxlan local 10.1.0.1 dstport 4789 id 5000 nolearning&lt;/div&gt;&lt;div&gt;ip link set vni4000 master br1 addrgenmode none&lt;/div&gt;&lt;div&gt;ip link set vni4000 type bridge_slave neigh_suppress on learning off&lt;/div&gt;&lt;div&gt;ip link set vni4000 up&lt;/div&gt;&lt;div&gt;bridge vlan add dev vni4000 vid 4000&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# L3-SVI（无IP，仅挂VRF）&lt;/div&gt;&lt;div&gt;ip link add br1.4000 link br1 type vlan id 4000&lt;/div&gt;&lt;div&gt;ip link set br1.4000 master Vrf1 addrgenmode none&lt;/div&gt;&lt;div&gt;ip link set br1.4000 up&lt;/div&gt;&lt;div&gt;sysctl -w net.ipv6.conf.br1.4000.addrgenmode=none &amp;gt;/dev/null&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="411" x="190" y="85" as="geometry" />
        </mxCell>
